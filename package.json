{
  "name": "oscar-studio-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "deploy": "bash ../sync-site.sh tools /www/wwwroot/tools.oscarstudio.cn",
    "test:word-counter": "node tests/word-counter-stats.test.mjs && node tests/word-counter-segments.test.mjs",
    "test:codec": "node tests/codec.test.mjs && node tests/codec-hashes.test.mjs",
    "test": "node tests/codec.test.mjs && node tests/codec-hashes.test.mjs && node tests/word-counter-stats.test.mjs && node tests/word-counter-segments.test.mjs",
    "prebuild": "node scripts/check-legacy-js.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "tldraw": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^3.1.5"
  }
}
