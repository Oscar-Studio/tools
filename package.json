{
  "name": "oscar-studio-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "deploy": "bash ../sync-site.sh tools /www/wwwroot/tools.oscarstudio.cn",
    "test:word-counter": "node tests/word-counter-stats.test.mjs && node tests/word-counter-segments.test.mjs",
    "test:codec": "node tests/codec.test.mjs && node tests/codec-hashes.test.mjs",
    "test:todo": "node tests/todo-datetime.test.mjs && node tests/todo-quickadd.test.mjs",
    "test:password-generator": "node tests/password-generator.test.mjs",
    "test:qrcode": "node tests/qrcode.test.mjs",
    "test:regex": "node tests/regex.test.mjs",
    "test:image-compressor": "node tests/image-compressor.test.mjs",
    "test:kaomoji": "node tests/kaomoji.test.mjs",
    "test": "node tests/codec.test.mjs && node tests/codec-hashes.test.mjs && node tests/word-counter-stats.test.mjs && node tests/word-counter-segments.test.mjs && node tests/todo-datetime.test.mjs && node tests/todo-quickadd.test.mjs && node tests/password-generator.test.mjs && node tests/qrcode.test.mjs && node tests/regex.test.mjs && node tests/image-compressor.test.mjs && node tests/kaomoji.test.mjs",
    "prebuild": "node scripts/check-legacy-js.mjs && node scripts/copy-zxcvbn-ts.mjs && node scripts/copy-qrcode.mjs",
    "postbuild": "node scripts/clean-dist-appledouble.mjs"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "framer-motion": "^11.11.17",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "tldraw": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^3.1.5"
  }
}
